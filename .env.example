# Optional: override the Prismic repository from prismic.config.json ("buzzvel").
# The repository API is public, so no access token is required.
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=

# Optional: secret configured on the Prismic webhook. Without it, /api/revalidate rejects every request.
PRISMIC_WEBHOOK_SECRET=

# Optional: where the contact form SQLite file is stored.
# Default: ./data/contact.db, or the OS temp folder when the project folder is read-only (e.g. Vercel).
CONTACT_DB_PATH=
